# Copy to .env for local runs. In production these come from the platform
# (Render → Environment). Secrets never go into git or the image.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
LOG_DIR=./logs

# Security (Lab 8)
ALLOWED_ORIGINS=
ALLOW_MISSING_ORIGIN=true
TRUST_PROXY=false
MAX_CONNECTIONS_PER_IP=8
MAX_ROOMS=12
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD=8192
MESSAGE_RATE=60
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
SLOW_CLIENT_BYTES=65536
SHUTDOWN_GRACE_MS=8000

# Game
TICK_RATE=30
BOTS=0
BOT_ROOM=alpha
BROADPHASE=hash
NET_LATENCY_MS=0
NET_JITTER_MS=0
NET_DROP_PCT=0

# Set by CI at image build time
GIT_SHA=dev
APP_VERSION=0.0.0-dev
