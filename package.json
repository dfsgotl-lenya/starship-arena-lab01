{
  "name": "starship-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "node --env-file=.env --import tsx --watch server/src/index.ts",
    "start": "node --env-file=.env --import tsx server/src/index.ts",
    "build": "npm run build --workspace client",
    "build:perf": "npm run build --workspace client -- --mode perf",
    "bench:codec": "tsx server/scripts/codec-benchmark.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "perf:record": "node scripts/perf/record-game.mjs",
    "perf:load": "tsx server/scripts/load-test.ts",
    "perf:charts": "python3 scripts/perf/charts.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.35.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.7"
  }
}
